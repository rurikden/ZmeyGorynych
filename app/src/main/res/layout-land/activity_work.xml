<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".WorkActivity">

    <!-- Основной контент -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:cardUseCompatPadding="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp">

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/horizontal_split_guide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.5" />

                <!-- Карточка календаря -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardCalendar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="6dp"
                    app:layout_constraintEnd_toStartOf="@id/horizontal_split_guide"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvSelectedDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:background="@drawable/date_background"
                            android:gravity="center"
                            android:padding="12dp"
                            android:text="Выбранная дата: Сегодня"
                            android:textColor="@color/black"
                            android:textSize="18sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <com.example.zmeygorynych.CustomCalendarView
                            android:id="@+id/customCalendarView"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvSelectedDate" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <!-- Карточка выбора времени -->

                <!-- Тестовая надпись под карточкой выбора времени -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardTimeParams"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="6dp"
                    app:layout_constraintStart_toEndOf="@id/horizontal_split_guide"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <!-- Вертикальная направляющая для выравнивания времени -->
                        <androidx.constraintlayout.widget.Guideline
                            android:id="@+id/guidelineTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            app:layout_constraintGuide_percent="0.35" />

                        <!-- Заголовок -->
                        <TextView
                            android:id="@+id/tvTimeTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Время работы"
                            android:textColor="@color/black"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <!-- Окно 1: с -->
                        <TextView
                            android:id="@+id/tvWindowLabel1"
                            android:layout_width="0dp"
            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Окно с"
                            android:textColor="@color/black"
            android:textSize="14sp"
            android:gravity="center_vertical"
                            app:layout_constraintEnd_toStartOf="@id/guidelineTime"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvTimeTitle" />

                        <TextView
                            android:id="@+id/tvWindowFrom1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="72dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/date_background"
                            android:gravity="center"
                            android:padding="6dp"
                            android:text="--:--"
                            app:layout_constraintStart_toStartOf="@id/guidelineTime"
                            app:layout_constraintTop_toTopOf="@id/tvWindowLabel1" />

                        <!-- Окно 1: до -->
                        <TextView
                            android:id="@+id/tvWindowLabel2"
                            android:layout_width="0dp"
            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Окно до"
                            android:textColor="@color/black"
            android:textSize="14sp"
            android:gravity="center_vertical"
                            app:layout_constraintEnd_toStartOf="@id/guidelineTime"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvWindowLabel1" />

                        <TextView
                            android:id="@+id/tvWindowTo1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="72dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/date_background"
                            android:gravity="center"
                            android:padding="6dp"
                            android:text="--:--"
                            app:layout_constraintStart_toStartOf="@id/guidelineTime"
                            app:layout_constraintTop_toTopOf="@id/tvWindowLabel2" />

                        <TextView
                            android:id="@+id/tvWindowHours1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            app:layout_constraintBottom_toBottomOf="@id/tvWindowTo1"
                            app:layout_constraintStart_toEndOf="@id/tvWindowTo1"
                            app:layout_constraintTop_toTopOf="@id/tvWindowTo1" />

                        <!-- Окно 2: с -->
                        <TextView
                            android:id="@+id/tvWindowLabel3"
                            android:layout_width="0dp"
            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Окно с"
                            android:textColor="@color/black"
            android:textSize="14sp"
            android:gravity="center_vertical"
                            app:layout_constraintEnd_toStartOf="@id/guidelineTime"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvWindowLabel2" />

                        <TextView
                            android:id="@+id/tvWindowFrom2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="72dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/date_background"
                            android:gravity="center"
                            android:padding="6dp"
                            android:text="--:--"
                            app:layout_constraintStart_toStartOf="@id/guidelineTime"
                            app:layout_constraintTop_toTopOf="@id/tvWindowLabel3" />

                        <!-- Окно 2: до -->
                        <TextView
                            android:id="@+id/tvWindowLabel4"
                            android:layout_width="0dp"
            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Окно до"
                            android:textColor="@color/black"
            android:textSize="14sp"
            android:gravity="center_vertical"
                            app:layout_constraintEnd_toStartOf="@id/guidelineTime"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvWindowLabel3" />

                        <TextView
                            android:id="@+id/tvWindowTo2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="72dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/date_background"
                            android:gravity="center"
                            android:padding="6dp"
                            android:text="--:--"
                            app:layout_constraintStart_toStartOf="@id/guidelineTime"
                            app:layout_constraintTop_toTopOf="@id/tvWindowLabel4" />

                        <TextView
                            android:id="@+id/tvWindowHours2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            app:layout_constraintBottom_toBottomOf="@id/tvWindowTo2"
                            app:layout_constraintStart_toEndOf="@id/tvWindowTo2"
                            app:layout_constraintTop_toTopOf="@id/tvWindowTo2" />

                        <!-- СКД 1: с -->
                        <TextView
                            android:id="@+id/tvSkdLabel1"
                            android:layout_width="0dp"
            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="СКД с"
                            android:textColor="@color/black"
            android:textSize="14sp"
            android:gravity="center_vertical"
                            app:layout_constraintEnd_toStartOf="@id/guidelineTime"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvWindowLabel4" />

                        <TextView
                            android:id="@+id/tvSkdFrom1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="72dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/date_background"
                            android:gravity="center"
                            android:padding="6dp"
                            android:text="--:--"
                            app:layout_constraintStart_toStartOf="@id/guidelineTime"
                            app:layout_constraintTop_toTopOf="@id/tvSkdLabel1" />

                        <!-- СКД 1: до -->
                        <TextView
                            android:id="@+id/tvSkdLabel2"
                            android:layout_width="0dp"
            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="СКД до"
                            android:textColor="@color/black"
            android:textSize="14sp"
            android:gravity="center_vertical"
                            app:layout_constraintEnd_toStartOf="@id/guidelineTime"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvSkdLabel1" />

                        <TextView
                            android:id="@+id/tvSkdTo1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="72dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/date_background"
                            android:gravity="center"
                            android:padding="6dp"
                            android:text="--:--"
                            app:layout_constraintStart_toStartOf="@id/guidelineTime"
                            app:layout_constraintTop_toTopOf="@id/tvSkdLabel2" />

                        <TextView
                            android:id="@+id/tvSkdHours1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            app:layout_constraintBottom_toBottomOf="@id/tvSkdTo1"
                            app:layout_constraintStart_toEndOf="@id/tvSkdTo1"
                            app:layout_constraintTop_toTopOf="@id/tvSkdTo1" />

                        <!-- СКД 2: с -->
                        <TextView
                            android:id="@+id/tvSkdLabel3"
                            android:layout_width="0dp"
            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="СКД с"
                            android:textColor="@color/black"
            android:textSize="14sp"
            android:gravity="center_vertical"
                            app:layout_constraintEnd_toStartOf="@id/guidelineTime"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvSkdLabel2" />

                        <TextView
                            android:id="@+id/tvSkdFrom2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="72dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/date_background"
                            android:gravity="center"
                            android:padding="6dp"
                            android:text="--:--"
                            app:layout_constraintStart_toStartOf="@id/guidelineTime"
                            app:layout_constraintTop_toTopOf="@id/tvSkdLabel3" />

                        <!-- СКД 2: до -->
                        <TextView
                            android:id="@+id/tvSkdLabel4"
                            android:layout_width="0dp"
            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="СКД до"
                            android:textColor="@color/black"
            android:textSize="14sp"
            android:gravity="center_vertical"
                            app:layout_constraintEnd_toStartOf="@id/guidelineTime"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvSkdLabel3" />

                        <TextView
                            android:id="@+id/tvSkdTo2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="72dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/date_background"
                            android:gravity="center"
                            android:padding="6dp"
                            android:text="--:--"
                            app:layout_constraintStart_toStartOf="@id/guidelineTime"
                            app:layout_constraintTop_toTopOf="@id/tvSkdLabel4" />

                        <TextView
                            android:id="@+id/tvSkdHours2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            app:layout_constraintBottom_toBottomOf="@id/tvSkdTo2"
                            app:layout_constraintStart_toEndOf="@id/tvSkdTo2"
                            app:layout_constraintTop_toTopOf="@id/tvSkdTo2" />

                        <!-- Зубов 1: с -->
                        <TextView
                            android:id="@+id/tvZubovLabel1"
                            android:layout_width="0dp"
            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Зубов с"
                            android:textColor="@color/black"
            android:textSize="14sp"
            android:gravity="center_vertical"
                            app:layout_constraintEnd_toStartOf="@id/guidelineTime"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvSkdLabel4" />

                        <TextView
                            android:id="@+id/tvZubovFrom1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="72dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/date_background"
                            android:gravity="center"
                            android:padding="6dp"
                            android:text="--:--"
                            app:layout_constraintStart_toStartOf="@id/guidelineTime"
                            app:layout_constraintTop_toTopOf="@id/tvZubovLabel1" />

                        <!-- Зубов 1: до -->
                        <TextView
                            android:id="@+id/tvZubovLabel2"
                            android:layout_width="0dp"
            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Зубов до"
                            android:textColor="@color/black"
            android:textSize="14sp"
            android:gravity="center_vertical"
                            app:layout_constraintEnd_toStartOf="@id/guidelineTime"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvZubovLabel1" />

                        <TextView
                            android:id="@+id/tvZubovTo1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="72dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/date_background"
                            android:gravity="center"
                            android:padding="6dp"
                            android:text="--:--"
                            app:layout_constraintStart_toStartOf="@id/guidelineTime"
                            app:layout_constraintTop_toTopOf="@id/tvZubovLabel2" />

                        <TextView
                            android:id="@+id/tvZubovHours1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            app:layout_constraintBottom_toBottomOf="@id/tvZubovTo1"
                            app:layout_constraintStart_toEndOf="@id/tvZubovTo1"
                            app:layout_constraintTop_toTopOf="@id/tvZubovTo1" />

                        <!-- Зубов 2: с -->
                        <TextView
                            android:id="@+id/tvZubovLabel3"
                            android:layout_width="0dp"
            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Зубов с"
                            android:textColor="@color/black"
            android:textSize="14sp"
            android:gravity="center_vertical"
                            app:layout_constraintEnd_toStartOf="@id/guidelineTime"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvZubovLabel2" />

                        <TextView
                            android:id="@+id/tvZubovFrom2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="72dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/date_background"
                            android:gravity="center"
                            android:padding="6dp"
                            android:text="--:--"
                            app:layout_constraintStart_toStartOf="@id/guidelineTime"
                            app:layout_constraintTop_toTopOf="@id/tvZubovLabel3" />

                        <!-- Зубов 2: до -->
                        <TextView
                            android:id="@+id/tvZubovLabel4"
                            android:layout_width="0dp"
            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Зубов до"
                            android:textColor="@color/black"
            android:textSize="14sp"
            android:gravity="center_vertical"
                            app:layout_constraintEnd_toStartOf="@id/guidelineTime"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvZubovLabel3" />

                        <TextView
                            android:id="@+id/tvZubovTo2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="72dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/date_background"
                            android:gravity="center"
                            android:padding="6dp"
                            android:text="--:--"
                            app:layout_constraintStart_toStartOf="@id/guidelineTime"
                            app:layout_constraintTop_toTopOf="@id/tvZubovLabel4" />

                        <TextView
                            android:id="@+id/tvZubovHours2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            app:layout_constraintBottom_toBottomOf="@id/tvZubovTo2"
                            app:layout_constraintStart_toEndOf="@id/tvZubovTo2"
                            app:layout_constraintTop_toTopOf="@id/tvZubovTo2" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <!-- Карточка параметров работы -->

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardWorkParams"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="6dp"
                    app:layout_constraintStart_toStartOf="@id/cardCalendar"
                    app:layout_constraintEnd_toEndOf="@id/cardCalendar"
                    app:layout_constraintTop_toBottomOf="@id/cardCalendar">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <!-- Зубов -->
                        <TextView
                            android:id="@+id/tvZubov"
                            android:layout_width="110dp"
                            android:layout_height="23dp"
                            android:layout_marginStart="16dp"
                            android:text="Зубов"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <Spinner
                            android:id="@+id/spinnerZubov"
                            android:layout_width="250dp"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toEndOf="@+id/tvZubov"
                            app:layout_constraintTop_toTopOf="@+id/tvZubov" />

                        <!-- СКД -->
                        <TextView
                            android:id="@+id/tvSkd"
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="СКД"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/spinnerZubov" />

                        <Spinner
                            android:id="@+id/spinnerSkd"
                            android:layout_width="250dp"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toEndOf="@+id/tvSkd"
                            app:layout_constraintTop_toBottomOf="@+id/tvZubov" />

                        <!-- Машинист -->
                        <TextView
                            android:id="@+id/tvMachinist"
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="Машинист"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/spinnerSkd" />

                        <Spinner
                            android:id="@+id/spinnerMachinist"
                            android:layout_width="250dp"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toEndOf="@+id/tvMachinist"
                            app:layout_constraintTop_toBottomOf="@+id/tvSkd" />

                        <!-- Машинист (второй) -->
                        <TextView
                            android:id="@+id/tvMachinist2"
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="Машинист"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/spinnerMachinist" />

                        <Spinner
                            android:id="@+id/spinnerMachinist2"
                            android:layout_width="250dp"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toEndOf="@+id/tvMachinist2"
                            app:layout_constraintTop_toBottomOf="@+id/spinnerMachinist" />

                        <!-- Руководитель -->
                        <TextView
                            android:id="@+id/tvManager"
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="Руководитель"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/spinnerMachinist2" />

                        <Spinner
                            android:id="@+id/spinnerManager"
                            android:layout_width="250dp"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toEndOf="@+id/tvManager"
                            app:layout_constraintTop_toBottomOf="@+id/tvMachinist2" />

                        <!-- Перегон 1 -->
                        <TextView
