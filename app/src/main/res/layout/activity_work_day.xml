<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".WorkDayActivity">

    <!-- Основной контент -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:paddingBottom="24dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:cardUseCompatPadding="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp">

                    <!-- Горизонтальная направляющая для разделения -->
                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/horizontal_divider"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.2" />

                    <!-- Текст с выбранной датой -->
                    <TextView
                        android:id="@+id/tvSelectedDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/date_background"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="Рабочий день: Сегодня"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Карточка параметров работы (спиннеры) - слева -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardWorkParams"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="6dp"
                        app:layout_constraintEnd_toStartOf="@id/horizontal_divider"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvSelectedDate">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp">

                            <!-- Зубов -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilZubov"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:hint="Зубов"
                                app:boxStrokeColor="?attr/colorPrimary"
                                app:hintTextColor="?attr/colorOnSurfaceVariant"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent">

                                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                    android:id="@+id/spinnerZubov"
                                    style="@style/CustomSpinnerStyle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="none" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <!-- СКД -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilSkd"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:hint="СКД"
                                app:boxStrokeColor="?attr/colorPrimary"
                                app:hintTextColor="?attr/colorOnSurfaceVariant"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tilZubov">

                                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                    android:id="@+id/spinnerSkd"
                                    style="@style/CustomSpinnerStyle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="none" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <!-- Машинист -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilMachinist"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:hint="Машинист"
                                app:boxStrokeColor="?attr/colorPrimary"
                                app:hintTextColor="?attr/colorOnSurfaceVariant"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tilSkd">

                                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                    android:id="@+id/spinnerMachinist"
                                    style="@style/CustomSpinnerStyle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="none" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <!-- Машинист (второй) -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilMachinist2"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:hint="Машинист 2"
                                app:boxStrokeColor="?attr/colorPrimary"
                                app:hintTextColor="?attr/colorOnSurfaceVariant"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tilMachinist">

                                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                    android:id="@+id/spinnerMachinist2"
                                    style="@style/CustomSpinnerStyle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="none" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <!-- Руководитель -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilManager"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:hint="Руководитель"
                                app:boxStrokeColor="?attr/colorPrimary"
                                app:hintTextColor="?attr/colorOnSurfaceVariant"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tilMachinist2">

                                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                    android:id="@+id/spinnerManager"
                                    style="@style/CustomSpinnerStyle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="none" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <!-- Перегон 1 -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilPeregon1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:hint="Перегон 1"
                                app:boxStrokeColor="?attr/colorPrimary"
                                app:hintTextColor="?attr/colorOnSurfaceVariant"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tilManager">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etPeregon1"
                                    style="@style/CustomSpinnerStyle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="text" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <!-- Перегон 2 -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilPeregon2"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:hint="Перегон 2"
                                app:boxStrokeColor="?attr/colorPrimary"
                                app:hintTextColor="?attr/colorOnSurfaceVariant"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tilPeregon1">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etPeregon2"
                                    style="@style/CustomSpinnerStyle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="text" />

                            </com.google.android.material.textfield.TextInputLayout>

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Карточка выбора времени - справа -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardTimeParams"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="16dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="6dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/horizontal_divider"
                        app:layout_constraintTop_toBottomOf="@id/tvSelectedDate">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp">

                            <!-- Заголовок карточки времени -->
                            <TextView
                                android:id="@+id/tvTimeCardTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="16dp"
                                android:gravity="center"
                                android:text="Время работы"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <!-- Окно 1: с -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilWindowFrom1"
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:hint="Окно с"
                                app:boxStrokeColor="?attr/colorPrimary"
                                app:hintTextColor="?attr/colorOnSurfaceVariant"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tvTimeCardTitle">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etWindowFrom1"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:clickable="true"
                                    android:cursorVisible="false"
                                    android:focusable="false"
                                    android:importantForAutofill="no"
                                    android:inputType="none"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <!-- Окно 1: до -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilWindowTo1"
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:hint="Окно до"
                                app:boxStrokeColor="?attr/colorPrimary"
                                app:hintTextColor="?attr/colorOnSurfaceVariant"
                                app:layout_constraintStart_toEndOf="@id/tilWindowFrom1"
                                app:layout_constraintTop_toTopOf="@id/tilWindowFrom1">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etWindowTo1"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:clickable="true"
                                    android:cursorVisible="false"
                                    android:focusable="false"
                                    android:importantForAutofill="no"
                                    android:inputType="none"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <!-- Окно 2: с -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilWindowFrom2"
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:hint="Окно с"
                                app:boxStrokeColor="?attr/colorPrimary"
                                app:hintTextColor="?attr/colorOnSurfaceVariant"
                                app:layout_constraintStart_toEndOf="@id/tilWindowTo1"
                                app:layout_constraintTop_toTopOf="@id/tilWindowFrom1">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etWindowFrom2"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:clickable="true"
                                    android:cursorVisible="false"
                                    android:focusable="false"
                                    android:importantForAutofill="no"
                                    android:inputType="none"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <!-- Окно 2: до -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilWindowTo2"
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:hint="Окно до"
                                app:boxStrokeColor="?attr/colorPrimary"
                                app:hintTextColor="?attr/colorOnSurfaceVariant"
                                app:layout_constraintStart_toEndOf="@id/tilWindowFrom2"
                                app:layout_constraintTop_toTopOf="@id/tilWindowFrom2">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etWindowTo2"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:clickable="true"
                                    android:cursorVisible="false"
                                    android:focusable="false"
                                    android:importantForAutofill="no"
                                    android:inputType="none"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <!-- СУММА часов окон -->
                            <TextView
                                android:id="@+id/tvWindowHoursSum"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="ч"
                                android:textColor="@color/black"
                                android:textSize="14sp"
                                app:layout_constraintBottom_toBottomOf="@id/tilWindowTo2"
                                app:layout_constraintStart_toEndOf="@id/tilWindowTo2"
                                app:layout_constraintTop_toTopOf="@id/tilWindowTo2" />

                            <!-- СКД 1: с -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilSkdFrom1"
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:hint="СКД с"
                                app:boxStrokeColor="?attr/colorPrimary"
                                app:hintTextColor="?attr/colorOnSurfaceVariant"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tilWindowFrom1">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etSkdFrom1"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:clickable="true"
                                    android:cursorVisible="false"
                                    android:focusable="false"
                                    android:importantForAutofill="no"
                                    android:inputType="none"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <!-- СКД 1: до -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilSkdTo1"
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:hint="СКД до"
                                app:boxStrokeColor="?attr/colorPrimary"
                                app:hintTextColor="?attr/colorOnSurfaceVariant"
                                app:layout_constraintStart_toEndOf="@id/tilSkdFrom1"
                                app:layout_constraintTop_toTopOf="@id/tilSkdFrom1">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etSkdTo1"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:clickable="true"
                                    android:cursorVisible="false"
                                    android:focusable="false"
                                    android:importantForAutofill="no"
                                    android:inputType="none"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <!-- СКД 2: с -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilSkdFrom2"
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:hint="СКД с"
                                app:boxStrokeColor="?attr/colorPrimary"
                                app:hintTextColor="?attr/colorOnSurfaceVariant"
                                app:layout_constraintStart_toEndOf="@id/tilSkdTo1"
                                app:layout_constraintTop_toTopOf="@id/tilSkdFrom1">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etSkdFrom2"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:clickable="true"
                                    android:cursorVisible="false"
                                    android:focusable="false"
                                    android:importantForAutofill="no"
                                    android:inputType="none"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <!-- СКД 2: до -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilSkdTo2"
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:hint="СКД до"
                                app:boxStrokeColor="?attr/colorPrimary"
                                app:hintTextColor="?attr/colorOnSurfaceVariant"
                                app:layout_constraintStart_toEndOf="@id/tilSkdFrom2"
                                app:layout_constraintTop_toTopOf="@id/tilSkdFrom2">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etSkdTo2"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:clickable="true"
                                    android:cursorVisible="false"
                                    android:focusable="false"
                                    android:importantForAutofill="no"
                                    android:inputType="none"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <!-- СУММА часов СКД -->
                            <TextView
                                android:id="@+id/tvSkdHoursSum"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="ч"
                                android:textColor="@color/black"
                                android:textSize="14sp"
                                app:layout_constraintBottom_toBottomOf="@id/tilSkdTo2"
                                app:layout_constraintStart_toEndOf="@id/tilSkdTo2"
                                app:layout_constraintTop_toTopOf="@id/tilSkdTo2" />

                            <!-- Зубов 1: с -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilZubovFrom1"
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:hint="Зубов с"
                                app:boxStrokeColor="?attr/colorPrimary"
                                app:hintTextColor="?attr/colorOnSurfaceVariant"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tilSkdFrom1">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etZubovFrom1"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:clickable="true"
                                    android:cursorVisible="false"
                                    android:focusable="false"
                                    android:importantForAutofill="no"
                                    android:inputType="none"
                                    android:maxLines="1"
                                    android:textSize="12sp" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <!-- Зубов 1: до -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilZubovTo1"
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:hint="Зубов до"
                                app:boxStrokeColor="?attr/colorPrimary"
                                app:hintTextColor="?attr/colorOnSurfaceVariant"
                                app:layout_constraintStart_toEndOf="@id/tilZubovFrom1"
                                app:layout_constraintTop_toTopOf="@id/tilZubovFrom1">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etZubovTo1"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:clickable="true"
                                    android:cursorVisible="false"
                                    android:focusable="false"
                                    android:importantForAutofill="no"
                                    android:inputType="none"
                                    android:maxLines="1"
                                    android:textSize="12sp" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <!-- Зубов 2: с -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilZubovFrom2"
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:hint="Зубов с"
                                app:boxStrokeColor="?attr/colorPrimary"
                                app:hintTextColor="?attr/colorOnSurfaceVariant"
                                app:layout_constraintStart_toEndOf="@id/tilZubovTo1"
                                app:layout_constraintTop_toTopOf="@id/tilZubovFrom1">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etZubovFrom2"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:clickable="true"
                                    android:cursorVisible="false"
                                    android:focusable="false"
                                    android:importantForAutofill="no"
                                    android:inputType="none"
                                    android:maxLines="1"
                                    android:textSize="12sp" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <!-- Зубов 2: до -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilZubovTo2"
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:hint="Зубов до"
                                app:boxStrokeColor="?attr/colorPrimary"
                                app:hintTextColor="?attr/colorOnSurfaceVariant"
                                app:layout_constraintStart_toEndOf="@id/tilZubovFrom2"
                                app:layout_constraintTop_toTopOf="@id/tilZubovFrom2">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etZubovTo2"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:clickable="true"
                                    android:cursorVisible="false"
                                    android:focusable="false"
                                    android:importantForAutofill="no"
                                    android:inputType="none"
                                    android:maxLines="1"
                                    android:textSize="12sp" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <!-- СУММА часов зубов -->
                            <TextView
                                android:id="@+id/tvZubovHoursSum"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="ч"
                                android:textColor="@color/black"
                                android:textSize="14sp"
                                app:layout_constraintBottom_toBottomOf="@id/tilZubovTo2"
                                app:layout_constraintStart_toEndOf="@id/tilZubovTo2"
                                app:layout_constraintTop_toTopOf="@id/tilZubovTo2" />

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Кнопка Запись -->
                    <Button
                        android:id="@+id/btnSave"
                        android:layout_width="200dp"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/button_ok_background"
                        android:text="@string/btn_make_an_entry"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/cardWorkParams" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </ScrollView>

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

